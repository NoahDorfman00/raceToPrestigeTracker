# Firebase Client Configuration (for frontend)
# Copy this file to .env and fill in your actual values
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
# Required for uploads to Firebase Storage (uploads are disabled if unset)
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Service Account (for backend authentication)
# This should be a JSON string of your Firebase service account key
# For local dev: Keep this empty and use firebase-service-account.json file
# For production: Set this to the full JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Authorized Admin Emails (comma-separated)
# Only these emails will have access to the admin panel.
# Required: if unset, all admin requests are rejected.
AUTHORIZED_ADMIN_EMAILS=your-email@gmail.com,another-email@gmail.com

# Path to the streamlink executable (optional).
# Only needed if streamlink is not on PATH or in the active virtualenv.
STREAMLINK_PATH=

# Backwards-reading confirmation (optional). A level/prestige reading lower than the
# stored value is only accepted after this many consistent readings over this many seconds.
REGRESSION_CONFIRM_COUNT=5
REGRESSION_CONFIRM_SECONDS=600

# Application Configuration
MAX_STREAMS=5
PORT=5001
FLASK_ENV=production

